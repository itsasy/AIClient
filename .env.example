# ==============================
# GEMINI
# ==============================

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_VISION_MODEL=gemini-2.0-flash-exp


# ==============================
# NVIDIA NIM
# ==============================

NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.1-70b-instruct


# =========================
# Provider Routing
# =========================

DEFAULT_PROVIDER=gemini
CODE_PROVIDER=nim
ARCHITECTURE_PROVIDER=nim

# Provider específico para documentación (README, etc.)
DOCUMENTATION_PROVIDER=nim
FALLBACK_PROVIDERS=nim,gemini


# ==============================
# Timeouts
# ==============================

# Tiempo máximo para comandos de Shell (segundos)
SHELL_TIMEOUT=180

# Tiempo máximo para comandos de Docker (segundos)
DOCKER_TIMEOUT=120

LARAVEL_TIMEOUT=900

# ==============================
# OBSIDIAN
# ==============================

OBSIDIAN_VAULT_PATH=~/Workspace/Obsidian

# ==============================
# DASHBOARD
# ==============================
DASHBOARD_API_KEY=tu_clave_super_secreta_aqui
DASHBOARD_DEBUG=false
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=5000


# ==============================
# SANDBOX DOCKER
# ==============================
SANDBOX_TIMEOUT=30
SANDBOX_MEMORY=256m
SANDBOX_CPU=1.0
SANDBOX_IMAGE=python:3.11-slim


# ==============================
# DEEPSEEK
# ==============================
DEEPSEEK_API_KEY=tu_api_key_deepseek
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_CODER_MODEL=deepseek-coder


# ==============================
# Opciones: "engram", "legacy", "both"
# both (por defecto): guarda y recupera de Engram + .standards.json.
# engram: solo usa Engram (SQLite con FTS5).
# legacy: solo usa .standards.json (compatibilidad).
# ==============================
LEARNER_BACKEND=both

# ==============================
# Modo de operación: "safe" o "powerful"
# ==============================
POWER_MODE=safe

ENGRAM_PROJECT=aiclient
